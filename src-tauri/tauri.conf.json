{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoReel Studio",
  "version": "0.1.0",
  "identifier": "com.autoreel.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoReel Studio",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "resources": [],
    "externalBin": [],
    "category": "Video",
    "shortDescription": "Animated short films + multi-platform publish (YouTube, X)",
    "longDescription": "AutoReel Studio makes animated short films and explainer shorts: story beats → Wan 2.1 clips → TTS → captions → assemble, then publish to YouTube, X, and more."
  },
  "plugins": {}
}
