# Google Cloud OAuth (YouTube Data API v3) — Installed / Desktop application client
# Create at: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret

# X (Twitter) API — OAuth 1.0a user context (media upload + v2 tweets)
# Create at: https://developer.x.com/en/portal/dashboard
# Needs Read and Write permissions on the app + generated access token/secret
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional OAuth2 client credentials (future / app-only flows)
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# Optional: Pexels stock footage fallback when Wan is unavailable
PEXELS_API_KEY=

# Sidecar
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8765
MOCK_WAN=1

# Hugging Face (optional, for gated models / higher rate limits)
# HF_TOKEN=
